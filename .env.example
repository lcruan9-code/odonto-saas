DATABASE_URL="postgresql://postgres:postgres@localhost:5432/odonto_saas?schema=public"
# Usada apenas por `prisma migrate deploy` (conexão direta, sem pgbouncer). Na Vercel+Supabase,
# aponte para a porta 5432; DATABASE_URL pode usar a porta 6543 (pooled) em produção.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/odonto_saas?schema=public"
NEXTAUTH_SECRET="replace-with-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# Chave para liberar a rota de seed via navegador (/api/seed?key=...). Sem ela, a rota fica desativada.
SEED_SECRET="replace-with-random-secret"
